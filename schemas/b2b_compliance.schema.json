{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B2BComplianceAuditFeed",
  "description": "Standardized schema for high-throughput enterprise WCAG 2.2 accessibility, security headers, GDPR privacy, AI readiness, and contact enrichment signals.",
  "type": "object",
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "title": { "type": ["string", "null"] },
    "complianceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "riskLevel": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"] },
    "accessibilityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "securityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "privacyScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "imagesTotal": { "type": "integer", "minimum": 0 },
    "imagesMissingAlt": { "type": "integer", "minimum": 0 },
    "inputsMissingLabels": { "type": "integer", "minimum": 0 },
    "hasViewportMeta": { "type": "boolean" },
    "hasHSTS": { "type": "boolean" },
    "hasCSP": { "type": "boolean" },
    "hasXFrameOptions": { "type": "boolean" },
    "hasPrivacyPolicy": { "type": "boolean" },
    "hasCookieConsent": { "type": "boolean" },
    "hasSchemaOrgJsonLd": { "type": "boolean" },
    "allowsAiCrawlers": { "type": "boolean" },
    "cmsDetected": { "type": ["string", "null"] },
    "analyticsDetected": { "type": ["array", "null"], "items": { "type": "string" } },
    "frameworksDetected": { "type": ["array", "null"], "items": { "type": "string" } },
    "emails": { "type": "array", "items": { "type": "string" } },
    "phones": { "type": "array", "items": { "type": "string" } },
    "socialLinks": { "type": "array", "items": { "type": "string" } },
    "remediationFixes": { "type": "array", "items": { "type": "string" } },
    "auditedAt": { "type": "string", "format": "date-time" },
    "error": { "type": ["string", "null"] }
  },
  "required": ["url", "complianceScore", "accessibilityScore", "securityScore", "privacyScore"]
}
