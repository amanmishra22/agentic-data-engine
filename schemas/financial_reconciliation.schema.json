{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinancialDocumentReconciliationFeed",
  "description": "Standardized schema for parsed financial PDF tables with deterministic Quantity × UnitPrice and row-sum reconciliation.",
  "type": "object",
  "properties": {
    "documentUrl": { "type": "string", "format": "uri" },
    "pageNumber": { "type": "integer", "minimum": 1 },
    "tableIndex": { "type": "integer", "minimum": 0 },
    "reconciliationStatus": {
      "type": "string",
      "enum": ["RECONCILED", "DISCREPANCY_DETECTED", "UNRECONCILED_NO_TOTAL", "NO_TABLE_FOUND", "ERROR"]
    },
    "declaredTotal": { "type": ["number", "null"] },
    "calculatedTotal": { "type": ["number", "null"] },
    "discrepancyDelta": { "type": ["number", "null"] },
    "declaredSubtotal": { "type": ["number", "null"] },
    "declaredTax": { "type": ["number", "null"] },
    "declaredDiscount": { "type": ["number", "null"] },
    "rowMathMismatches": { "type": "integer", "minimum": 0 },
    "rowCount": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string" },
    "invoiceNumber": { "type": ["string", "null"] },
    "documentDate": { "type": ["string", "null"] },
    "taxIds": { "type": "array", "items": { "type": "string" } },
    "columns": { "type": "array", "items": { "type": "string" } },
    "rows": { "type": "array", "items": { "type": "object" } },
    "markdownTable": { "type": ["string", "null"] },
    "confidenceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "reconciledAt": { "type": "string", "format": "date-time" },
    "error": { "type": ["string", "null"] }
  },
  "required": ["documentUrl", "pageNumber", "tableIndex", "reconciliationStatus", "confidenceScore"]
}
